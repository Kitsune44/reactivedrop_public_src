//------------------------------------------------------------------------------------------
// Inputs
//------------------------------------------------------------------------------------------

sampler samplerY : register( s0 );
sampler samplerU : register( s1 );
sampler samplerV : register( s2 );

float4 texSizeY : register(c0);


struct PS_INPUT
{
    float4 projPos  : SV_POSITION;
    float2 uv       : TEXCOORD;
};

//------------------------------------------------------------------------------------------
// Sampling YUV textures
//------------------------------------------------------------------------------------------


/* 
 * @brief In the case of bit depth larger than 8 bits,
 * we saved uint16_t words in two 8-bit UV88 texture channels,
 * so we need to reconstruct them.
 *
 * @param rg - from sampler with UV88: float2 in [ -1, 1 ] range where uint8_t are mapped: [ 0, 127 ] => [ 0, 1 ] and [ 128, 255 ] => [ -1, 0 ]
 *
 * @return float in [ 0, 1 ] range ( [ 0, MAX_VAL ] => [ 0, 1 ]) )
 */

//#if SRC_BIT_DEPTH != SRC_BIT_DEPTH_8
//inline float unpackUV88( float2 uv88 )
//{
//    uv88 *= 0.5f;
//    uv88 += step( uv88, float2( -1e-6f, -1e-6f ) );

//    return ( 256 * uv88.g + uv88.r ) * SCALE;
//}
//#endif
#if SRC_BIT_DEPTH != SRC_BIT_DEPTH_8
inline float unpackUV88(float2 uv88)
{
    uv88 = mad(uv88, 0.5f, step(uv88, float2(-1e-6f, -1e-6f)));
    return mad(256.0f, uv88.g, uv88.r) * SCALE;
}
#endif

inline float3 getSampleYUV( float2 uv )
{
#if SRC_BIT_DEPTH == SRC_BIT_DEPTH_8 
    float3 yuv = float3(
        tex2D( samplerY, uv ).r,
        tex2D( samplerU, uv ).r,
        tex2D( samplerV, uv ).r
    );
#else
    float3 yuv = float3(
        unpackUV88( tex2D( samplerY, uv ).rg ),
        unpackUV88( tex2D( samplerU, uv ).rg ),
        unpackUV88( tex2D( samplerV, uv ).rg )
    );
#endif

//#if AVCOL_RANGE != AVCOL_RANGE_JPEG
//    yuv = (yuv - YUV_OFFSET_VEC) * YUV_SCALE_VEC;
//#endif
//    yuv.yz -= 0.5;
#if AVCOL_RANGE != AVCOL_RANGE_JPEG
    yuv = mad( yuv, YUV_SCALE_VEC, YUV_OFFSET_VEC );
#else
    yuv.yz -= 0.5f;
#endif

    return yuv;
}


//// Catmull-Rom cubic weights
//inline float4 cubicWeights(float t)
//{
//    float tt = t * t;
//    float ttt = tt * t;
//    return float4(
//        -0.5 * ttt + tt - 0.5 * t,
//         1.5 * ttt - 2.5 * tt + 1.0,
//        -1.5 * ttt + 2.0 * tt + 0.5 * t,
//         0.5 * ttt - 0.5 * tt
//    );
//}
// Catmull-Rom cubic weights
inline float4 cubicWeights(float t)
{
    float t2 = t * t;
    float t3 = t2 * t;
    return float4(
        mad(-0.5f, t3, mad(1.0f, t2, -0.5f * t)),
        mad(1.5f, t3, mad(-2.5f, t2, 1.0f)),
        mad(-1.5f, t3, mad(2.0f, t2, 0.5f * t)),
        mad(0.5f, t3, -0.5f * t2)
    );
}

