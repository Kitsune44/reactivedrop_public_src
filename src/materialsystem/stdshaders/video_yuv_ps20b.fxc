//inline float3 getSampleYUV_Bicubic(float2 uv)
//{
//    float2 f = frac(uv * texSizeY.zw);
//    float4 wx = cubicWeights(f.x);
//    float4 wy = cubicWeights(f.y);

//    float3 result = float3(0, 0, 0);

//    [unroll]
//    for (int j = -1; j <= 2; ++j)
//    {
//        float wyj = wy[j + 1];
//        [unroll]
//        for (int i = -1; i <= 2; ++i)
//        {
//            float sampleWeight = wx[i + 1] * wyj;
//            float2 sampleUV = uv + float2(i, j) * texSizeY.xy;
//            result += getSampleYUV(sampleUV) * sampleWeight;
//        }
//    }

//    return result;
//}

// Bicubic sampling
inline float3 getSampleYUV_Bicubic(float2 uv)
{
    // frac in texel space
    float2 f = frac(uv * texSizeY.zw);
    float4 wx = cubicWeights(f.x);
    float4 wy = cubicWeights(f.y);

    float3 result = float3(0, 0, 0);
    float2 texelSize = texSizeY.xy;
    
    [unroll]
    for (int j = -1; j <= 2; j++)
    {
        float wyj = wy[j + 1];
        float2 coord = mad(float2(0, j), texelSize, uv);

        [unroll]
        for (int i = -1; i <= 2; i++)
        {
            float2 sampleUV = mad(float2(i, 0), texelSize, coord);
            result = mad(wx[i + 1] * wyj, getSampleYUV(sampleUV), result);
        }
    }

    return result;
}

//------------------------------------------------------------------------------------------
// Converting RGB to Linear RGB
//------------------------------------------------------------------------------------------

inline float3 rgbInverseEOTF(float3 rgb)
{
#if AVCOL_TRC == AVCOL_TRC_BT709 || AVCOL_TRC == AVCOL_TRC_SMPTE170M || AVCOL_TRC == AVCOL_TRC_BT2020_10 || AVCOL_TRC == AVCOL_TRC_BT2020_12
    const float a = 1.099296826809442;
    const float b = 4.5f * 0.018053968510807;
    return (rgb < b)
        ? (rgb / 4.5f)
        : pow(max((rgb + (a - 1.0f)) / a, 0.0f), 1.0f / 0.45f);

#elif AVCOL_TRC == AVCOL_TRC_GAMMA22
    return pow(max(rgb, 0.0f), 2.2f);

#elif AVCOL_TRC == AVCOL_TRC_GAMMA28
    return pow(max(rgb, 0.0f), 2.8f);
    
#elif AVCOL_TRC == AVCOL_TRC_SMPTE240M
    const float a = 1.1115f;
    const float b = 4.0f * 0.022824f;
    return (rgb < b)
        ? (rgb / 4.0f)
        : pow(max((rgb + (a - 1.0f)) / a, 0.0f), 1.0f / 0.45f);

#elif AVCOL_TRC == AVCOL_TRC_LINEAR
    return rgb;

#elif AVCOL_TRC == AVCOL_TRC_LOG100
    return (rgb <= 0.0f)
        ? 0.01f
        : pow(10.0f, 2.0f * (rgb - 1.0f));

#elif AVCOL_TRC == AVCOL_TRC_LOG_SQRT
    return (rgb <= 0.0f)
        ? 0.00316227766
        : pow(10.0f, 2.5f * (rgb - 1.0f));

#elif AVCOL_TRC == AVCOL_TRC_IEC61966_2_4
    const float a = 1.099296826809442;
    const float b = 4.5f * 0.018053968510807;
    return (rgb <= -b)
        ? -pow(max((-(rgb) + (a - 1.0f)) / a, 0.0f), 1.0f / 0.45f)
        : (rgb < b)
            ? (rgb / 4.5f)
            : pow(max((rgb + (a - 1.0f)) / a, 0.0f), 1.0f / 0.45f);

#elif AVCOL_TRC == AVCOL_TRC_BT1361_ECG
    const float a = 1.099296826809442;
    const float b = 4.5f * 0.018053968510807;
     return ( rgb <= -0.02025)
        ? -pow(max((-4.0f * rgb - (a - 1.0f)) / a, 0.0f), 1.0f / 0.45f) / 4.0f
        : (rgb < b)
            ? rgb / 4.5f
            : pow(max(( rgb + (a - 1.0f)) / a, 0.0f), 1.0f / 0.45f);

#elif AVCOL_TRC == AVCOL_TRC_IEC61966_2_1
     const float a = 1.055f;
     const float b = 12.92f * 0.0031308f;
     return ( rgb < b)
        ? rgb / 12.92f
        : pow(max((rgb + (a - 1.0f)) / a, 0.0f), 2.4f);

#elif AVCOL_TRC == AVCOL_TRC_SMPTE2084
    #define DST_LUMA_SCALE 0.01f
    const float  c1 = (        3424.0 / 4096.0);
    const float  c2 = ( 32.0 * 2413.0 / 4096.0);
    const float  c3 = ( 32.0 * 2392.0 / 4096.0);
    const float  m  = (128.0 * 2523.0 / 4096.0);
    const float  n  = ( 0.25 * 2610.0 / 4096.0);
    const float3 Em = pow(max(rgb, 0.0f), 1.0f / m);
    return (c1 > Em)
        ? 0.0f
        : 10000.0f * pow(max((Em - c1) / (c2 - c3 * Em), 0.0f), 1.0f / n);

#elif AVCOL_TRC == AVCOL_TRC_SMPTE428
    const float scale428 = 52.37f / 48.0f;
    return pow(max(rgb, 0.0f), 2.6f) * scale428;
    
#else //#elif AVCOL_TRC == AVCOL_TRC_ARIB_STD_B67
    #define DST_LUMA_SCALE 10
    const float a = 0.17883277f;
    const float b = 0.28466892f;
    const float c = 0.55991073f;
    return (rgb <= 0.5f)
        ? (rgb * rgb * (1.0f / 3.0f))
        : ((exp((rgb - c) / a) + b) * (1.0f / 12.0f));
#endif
}

//------------------------------------------------------------------------------------------
// Tone Mapping
//------------------------------------------------------------------------------------------

#if IS_HDR
/* http://filmicworlds.com/blog/filmic-tonemapping-operators/ */
inline float3 hable(float3 rgb)
{
    //const float A = 0.15, B = 0.50, C = 0.10, D = 0.20, E = 0.02, F = 0.30;
    //return ((rgb * (A * rgb + (C * B)) + (D * E)) / (rgb * (A * rgb + B) + (D * F))) - E / F;

    return ((rgb * (0.15 * rgb + 0.05) + 0.004) / (rgb * (0.15 * rgb + 0.50) + (0.06))) - 0.06666666;
}

inline float3 toneMapping(float3 rgb)
{
#ifndef DST_LUMA_SCALE
    #define DST_LUMA_SCALE 1
#endif
    //const float3 HABLE_DIV = 1 / hable(11.2);
    //rgb = rgb * DST_LUMA_SCALE;
    //return hable(rgb) * HABLE_DIV;

    return hable(rgb * DST_LUMA_SCALE) * 1.3790642466494378;
}
#endif

//------------------------------------------------------------------------------------------
// Main function
//------------------------------------------------------------------------------------------

float4 main( PS_INPUT input ) : SV_TARGET
{
    
#if SRC_BIT_DEPTH == SRC_BIT_DEPTH_8 
    float3 data = getSampleYUV(input.uv);
#else
    float3 data = getSampleYUV_Bicubic(input.uv);
#endif
    
    data = mul(MATRIX_YUV_RGB, data);
    data = max( data, 0.0f );
 
#if AVCOL_SPC != AVCOL_SPC_BT709
 
    data = rgbInverseEOTF(data);
    
#if IS_HDR
    data = toneMapping( data );
#endif

    data = mul(MATRIX_RGB_BT709, data);
    
    data = pow(max(data, 0.0f), 1.0 / 2.2);
    
#endif

    return float4(data, 1.0f);
}
